# Copy to `.env` and fill in. Never commit the real file.

# --- Required ---
MONGO_URI="YOUR_MONGO_URI"
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# --- Google Sign-In (optional; public OAuth client id) ---
GOOGLE_CLIENT_ID=""

# --- Observability (optional; tracing is a no-op without it) ---
LOGFIRE_TOKEN=""

# --- Portkey LLM gateway (optional; falls back to calling Groq directly) ---
PORTKEY_API_KEY=""
PORTKEY_GROQ_PROVIDER="groq"

# --- Live evals on every chat (optional) ---
ONLINE_EVALS_ENABLED=false
